# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Application ---
APP_NAME=SentinelForge API
# development | test | production
ENVIRONMENT=development
DEBUG=false
ENABLE_API_DOCS=true

# --- Database (PostgreSQL + psycopg 3) ---
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://sentinelforge_app:CHANGE_ME@localhost:5432/sentinelforge
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false

# --- Tests only: MUST point to a separate database whose name ends with _test ---
TEST_DATABASE_URL=postgresql+psycopg://sentinelforge_app:CHANGE_ME@localhost:5432/sentinelforge_test

# --- Authentication ---
# REQUIRED. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_48_byte_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
# scrypt cost. 2**15 = 32768 uses ~64 MiB and ~200 ms per login.
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=2
# Cookies: keep false on http://localhost, set true wherever HTTPS is used.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Login/register throttling per client IP.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (structured) | text (readable locally)
LOG_FORMAT=text

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Planned (later phases, not used yet) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# VECTOR_DB_PATH=
# SONARQUBE_URL=
# SONARQUBE_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
