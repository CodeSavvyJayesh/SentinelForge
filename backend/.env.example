# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Application ---
APP_NAME=SentinelForge API
# development | test | production
ENVIRONMENT=development
DEBUG=false
ENABLE_API_DOCS=true

# --- Database (PostgreSQL + psycopg 3) ---
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://sentinelforge_app:CHANGE_ME@localhost:5432/sentinelforge
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false

# --- Tests only: MUST point to a separate database whose name ends with _test ---
TEST_DATABASE_URL=postgresql+psycopg://sentinelforge_app:CHANGE_ME@localhost:5432/sentinelforge_test

# --- Authentication ---
# REQUIRED. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_48_byte_value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_MIN_LENGTH=12
# scrypt cost. 2**15 = 32768 uses ~64 MiB and ~200 ms per login.
SCRYPT_N=32768
SCRYPT_R=8
SCRYPT_P=2
# Cookies: keep false on http://localhost, set true wherever HTTPS is used.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Login/register throttling per client IP.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Repository ingestion (Phase 4) ---
# Where uploaded and cloned code is stored. One directory per repository.
# Keep it off any path that is served by a web server.
WORKSPACE_ROOT=./workspaces
# Compressed upload cap (100 MB).
MAX_ARCHIVE_BYTES=104857600
# Expanded size cap and maximum expansion factor: together these stop zip bombs.
MAX_UNCOMPRESSED_BYTES=524288000
MAX_COMPRESSION_RATIO=100
MAX_FILES=20000
MAX_FILE_BYTES=5242880
MAX_REPOSITORIES_PER_PROJECT=20
CLONE_TIMEOUT_SECONDS=120
GIT_COMMAND_TIMEOUT_SECONDS=15
# Leave both false. The first allows http:// clone URLs, the second allows
# hosts that resolve to a private address — that one re-opens SSRF, so turn it
# on only for an internal Git server on a trusted network.
ALLOW_INSECURE_GIT_URLS=false
ALLOW_PRIVATE_GIT_HOSTS=false

# --- Static analysis (Phase 5) ---
# Files bigger than this are generated bundles, not source worth parsing.
ANALYSIS_MAX_FILE_BYTES=1048576
# Past this many findings the result is marked truncated rather than pretending
# to be complete.
ANALYSIS_MAX_FINDINGS=2000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (structured) | text (readable locally)
LOG_FORMAT=text

# --- HTTP ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Planned (later phases, not used yet) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
# VECTOR_DB_PATH=
# SONARQUBE_URL=
# SONARQUBE_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
