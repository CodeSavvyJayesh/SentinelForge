# Copy this file to ".env" in the same folder, then fill in the two values.
# ".env" is ignored by git: it must never be committed.

# The database password. Letters and digits only (it is placed inside a URL).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# The key that signs login tokens. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. The ports on this machine.
# API_PORT=8000
# WEB_PORT=5173

# Optional. Where Ollama listens, as seen from inside the backend container.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional. "true" installs the knowledge-base packages (about 400 MB more).
# WITH_KNOWLEDGE=false
